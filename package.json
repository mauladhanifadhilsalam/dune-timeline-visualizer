{
  "name": "dune-timeline-visualizer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Interactive 3D timeline of the Dune saga, from the Time of Titans to the Scattering's return.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/three": "0.186.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "5.0.5"
  }
}
